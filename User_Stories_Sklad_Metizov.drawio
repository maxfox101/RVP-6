<mxfile host="app.diagrams.net" modified="2026-10-05T18:51:00.000Z" agent="Cursor" version="24.7.17" type="device">
  <diagram id="user-stories-sklad" name="User Stories — Склад метизов">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="2200" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- Заголовок -->
        <mxCell id="title" value="User Stories — ИС управления логистикой склада крепёжных изделий (метизов)" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontStyle=1;fontSize=18;fontColor=#1a1a1a;" vertex="1" parent="1">
          <mxGeometry x="80" y="20" width="1440" height="40" as="geometry"/>
        </mxCell>

        <!-- ========== РОЛЬ: МЕНЕДЖЕР ========== -->
        <mxCell id="role-mgr" value="Роль: Менеджер по продажам" style="swimlane;fontStyle=1;childLayout=stackLayout;horizontal=1;startSize=36;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="40" y="80" width="480" height="320" as="geometry"/>
        </mxCell>

        <mxCell id="us-01" value="&lt;b&gt;US-01 (UR-01)&lt;/b&gt;&lt;br&gt;Как менеджер, я хочу зарегистрировать клиентский заказ с выбором параметров крепежа (стандарт, диаметр, покрытие) из справочника, чтобы оформить заказ без ошибок номенклатуры." style="text;strokeColor=#6c8ebf;fillColor=#ffffff;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=11;whiteSpace=wrap;html=1;" vertex="1" parent="role-mgr">
          <mxGeometry y="36" width="480" height="90" as="geometry"/>
        </mxCell>

        <mxCell id="us-02" value="&lt;b&gt;US-02 (UR-02)&lt;/b&gt;&lt;br&gt;Как менеджер, я хочу просматривать обеспеченность каждой позиции заказа (полностью / частично / ожидает производства), чтобы понимать, что можно отгрузить со склада." style="text;strokeColor=#6c8ebf;fillColor=#ffffff;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=11;whiteSpace=wrap;html=1;" vertex="1" parent="role-mgr">
          <mxGeometry y="126" width="480" height="90" as="geometry"/>
        </mxCell>

        <mxCell id="us-03" value="&lt;b&gt;US-03 (UR-03)&lt;/b&gt;&lt;br&gt;Как менеджер, я хочу видеть расчётный срок отгрузки по заказу, чтобы сообщить клиенту реалистичную дату поставки." style="text;strokeColor=#6c8ebf;fillColor=#ffffff;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=11;whiteSpace=wrap;html=1;" vertex="1" parent="role-mgr">
          <mxGeometry y="216" width="480" height="90" as="geometry"/>
        </mxCell>

        <!-- ========== РОЛЬ: КЛАДОВЩИК ========== -->
        <mxCell id="role-wh" value="Роль: Кладовщик" style="swimlane;fontStyle=1;childLayout=stackLayout;horizontal=1;startSize=36;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="560" y="80" width="500" height="580" as="geometry"/>
        </mxCell>

        <mxCell id="us-04" value="&lt;b&gt;US-04 (UR-04)&lt;/b&gt;&lt;br&gt;Как кладовщик, я хочу просматривать свободный остаток номенклатуры с учётом резервов, чтобы знать, сколько товара реально доступно." style="text;strokeColor=#82b366;fillColor=#ffffff;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=11;whiteSpace=wrap;html=1;" vertex="1" parent="role-wh">
          <mxGeometry y="36" width="500" height="85" as="geometry"/>
        </mxCell>

        <mxCell id="us-05" value="&lt;b&gt;US-05 (UR-05)&lt;/b&gt;&lt;br&gt;Как кладовщик, я хочу зарезервировать товар под конкретный заказ, чтобы исключить конфликт резервирования одной позиции." style="text;strokeColor=#82b366;fillColor=#ffffff;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=11;whiteSpace=wrap;html=1;" vertex="1" parent="role-wh">
          <mxGeometry y="121" width="500" height="85" as="geometry"/>
        </mxCell>

        <mxCell id="us-06" value="&lt;b&gt;US-06 (UR-06)&lt;/b&gt;&lt;br&gt;Как кладовщик, я хочу отметить позиции заказа как собранные, чтобы зафиксировать результат комплектации." style="text;strokeColor=#82b366;fillColor=#ffffff;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=11;whiteSpace=wrap;html=1;" vertex="1" parent="role-wh">
          <mxGeometry y="206" width="500" height="85" as="geometry"/>
        </mxCell>

        <mxCell id="us-07" value="&lt;b&gt;US-07 (UR-07)&lt;/b&gt;&lt;br&gt;Как кладовщик, я хочу выполнить проверку метизов (стандарт, размер, покрытие, количество) перед отгрузкой, чтобы не допустить ошибочную комплектацию." style="text;strokeColor=#82b366;fillColor=#ffffff;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=11;whiteSpace=wrap;html=1;" vertex="1" parent="role-wh">
          <mxGeometry y="291" width="500" height="85" as="geometry"/>
        </mxCell>

        <mxCell id="us-08" value="&lt;b&gt;US-08 (UR-08)&lt;/b&gt;&lt;br&gt;Как кладовщик, я хочу оформить отгрузку заказа клиенту, чтобы списать резерв и закрыть заказ." style="text;strokeColor=#82b366;fillColor=#ffffff;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=11;whiteSpace=wrap;html=1;" vertex="1" parent="role-wh">
          <mxGeometry y="376" width="500" height="85" as="geometry"/>
        </mxCell>

        <mxCell id="us-09" value="&lt;b&gt;US-09 (UR-09)&lt;/b&gt;&lt;br&gt;Как кладовщик, я хочу сверить расчётный вес партии с фактическим взвешиванием при отгрузке, чтобы выявить расхождения." style="text;strokeColor=#82b366;fillColor=#ffffff;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=11;whiteSpace=wrap;html=1;" vertex="1" parent="role-wh">
          <mxGeometry y="461" width="500" height="85" as="geometry"/>
        </mxCell>

        <!-- ========== РОЛЬ: ПРОИЗВОДСТВО ========== -->
        <mxCell id="role-prod" value="Роль: Производственный отдел" style="swimlane;fontStyle=1;childLayout=stackLayout;horizontal=1;startSize=36;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=14;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="1100" y="80" width="460" height="230" as="geometry"/>
        </mxCell>

        <mxCell id="us-10" value="&lt;b&gt;US-10 (UR-10)&lt;/b&gt;&lt;br&gt;Как сотрудник производства, я хочу просматривать заявки на изготовление недостающего крепежа, чтобы планировать выпуск." style="text;strokeColor=#d79b00;fillColor=#ffffff;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=11;whiteSpace=wrap;html=1;" vertex="1" parent="role-prod">
          <mxGeometry y="36" width="460" height="90" as="geometry"/>
        </mxCell>

        <mxCell id="us-11" value="&lt;b&gt;US-11 (UR-11)&lt;/b&gt;&lt;br&gt;Как сотрудник производства, я хочу зафиксировать поступление готовой продукции на склад, чтобы обновить остатки и закрыть дефицит." style="text;strokeColor=#d79b00;fillColor=#ffffff;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=11;whiteSpace=wrap;html=1;" vertex="1" parent="role-prod">
          <mxGeometry y="126" width="460" height="90" as="geometry"/>
        </mxCell>

        <!-- ========== РОЛЬ: РУКОВОДИТЕЛЬ ========== -->
        <mxCell id="role-lead" value="Роль: Руководитель склада" style="swimlane;fontStyle=1;childLayout=stackLayout;horizontal=1;startSize=36;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="40" y="440" width="480" height="320" as="geometry"/>
        </mxCell>

        <mxCell id="us-12" value="&lt;b&gt;US-12 (UR-12)&lt;/b&gt;&lt;br&gt;Как руководитель склада, я хочу просматривать показатели по нехваткам товара, чтобы контролировать дефицит." style="text;strokeColor=#9673a6;fillColor=#ffffff;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=11;whiteSpace=wrap;html=1;" vertex="1" parent="role-lead">
          <mxGeometry y="36" width="480" height="90" as="geometry"/>
        </mxCell>

        <mxCell id="us-13" value="&lt;b&gt;US-13 (UR-13)&lt;/b&gt;&lt;br&gt;Как руководитель склада, я хочу просматривать позиции с минимальным уровнем остатка, чтобы вовремя запускать пополнение." style="text;strokeColor=#9673a6;fillColor=#ffffff;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=11;whiteSpace=wrap;html=1;" vertex="1" parent="role-lead">
          <mxGeometry y="126" width="480" height="90" as="geometry"/>
        </mxCell>

        <mxCell id="us-14" value="&lt;b&gt;US-14 (UR-14)&lt;/b&gt;&lt;br&gt;Как руководитель склада, я хочу запускать переучёт по выбранным позициям номенклатуры, чтобы сверить учёт с фактом." style="text;strokeColor=#9673a6;fillColor=#ffffff;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=11;whiteSpace=wrap;html=1;" vertex="1" parent="role-lead">
          <mxGeometry y="216" width="480" height="90" as="geometry"/>
        </mxCell>

        <!-- ========== РОЛЬ: АДМИНИСТРАТОР ========== -->
        <mxCell id="role-admin" value="Роль: Администратор" style="swimlane;fontStyle=1;childLayout=stackLayout;horizontal=1;startSize=36;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;fillColor=#f8cecc;strokeColor=#b85450;fontSize=14;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="1100" y="350" width="460" height="140" as="geometry"/>
        </mxCell>

        <mxCell id="us-15" value="&lt;b&gt;US-15 (UR-15)&lt;/b&gt;&lt;br&gt;Как администратор, я хочу назначать роли сотрудникам системы, чтобы разграничить доступ к функциям." style="text;strokeColor=#b85450;fillColor=#ffffff;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=11;whiteSpace=wrap;html=1;" vertex="1" parent="role-admin">
          <mxGeometry y="36" width="460" height="90" as="geometry"/>
        </mxCell>

        <!-- Легенда / трассируемость -->
        <mxCell id="legend" value="Трассируемость: US ↔ UR таблицы 2; связь с Use Case — таблица 5 (UC-01…UC-08).&#xa;Формат: «Как &lt;роль&gt;, я хочу &lt;действие&gt;, чтобы &lt;цель&gt;»." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="560" y="700" width="500" height="60" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
